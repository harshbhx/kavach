{
  "name": "@kavach/dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-runs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-runs.mjs",
    "build": "tsc -b && vite build",
    "build:site": "node scripts/copy-runs.mjs && tsc -b && vite build --base=/dashboard/ --outDir ../web/public/dashboard --emptyOutDir",
    "lint": "oxlint && tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kavach/brand": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "diff": "^9.0.0",
    "lucide-react": "^1.78.0",
    "motion": "^12.23.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
