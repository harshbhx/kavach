{
  "name": "@kavach/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "predev": "node scripts/sync-docs.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-docs.mjs && pnpm --filter @kavach/dashboard build:site",
    "build": "next build",
    "build:cf": "STATIC_EXPORT=1 pnpm run build",
    "deploy:cf": "pnpm run build:cf && wrangler deploy",
    "preview:cf": "wrangler dev",
    "start": "next start",
    "lint": "next typegen && oxlint && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "video": "node scripts/record-video.mjs",
    "film:lift": "node scripts/film-lift.mjs"
  },
  "dependencies": {
    "@kavach/brand": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.7",
    "lucide-react": "^1.71.0",
    "mermaid": "^12.3.0",
    "motion": "^12.43.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.32",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.167.0"
  }
}
