# ─── Kavach configuration ─── copy to .env (never commit .env)

# Brains for the 7 Kavach agents: lyzr | direct | fake
BRAIN_PROVIDER=lyzr

# Lyzr (https://docs.lyzr.ai)
LYZR_API_KEY=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai/v3
LYZR_USER_ID=your-lyzr-account-email
LYZR_AGENT_RECON=
LYZR_AGENT_INJECTION=
LYZR_AGENT_SOCIAL=
LYZR_AGENT_MONITOR=
LYZR_AGENT_PATCHER=
LYZR_AGENT_AUDITOR=
LYZR_AGENT_REFEREE=

# Direct brain fallback (LiteLLM model string; uses the provider key below)
DIRECT_MODEL=anthropic/claude-haiku-5-5

# Target (DiwaliMart Support)
TARGET_URL=http://localhost:8001
# JSON object of extra headers, e.g. {"X-Agent37-Key": "..."} when the target runs on Agent37
TARGET_EXTRA_HEADERS={}
# LiteLLM model string for the target, or "fake" for the offline scripted target used in smoke tests
TARGET_MODEL=anthropic/claude-haiku-5-5
TARGET_TEMPERATURE=0.2

# LLM provider keys (set whichever your models need)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Band (https://docs.band.ai)
BAND_ENABLED=true
# VERIFY: the reference docs use api.band.ai, the overview uses app.band.ai
BAND_API_BASE=https://api.band.ai/api/v1
BAND_AGENT_CONFIG=agent_config.yaml
# Your Band user UUID; the Referee adds you to every Kavach room
BAND_OWNER_USER_ID=

# Agent37 (https://www.agent37.com/docs), used only by scripts/deploy_target_agent37.sh
AGENT37_API_KEY=

# Run parameters
ROUNDS=3
ATTACKS_PER_AGENT=3
MAX_PATCH_ATTEMPTS=3
UTILITY_THRESHOLD=0.9
REPLAY_MAX_BREACH=0.34
MAX_CONCURRENCY=6
LLM_TIMEOUT_S=45
SEED=42

# API / dashboard
DASHBOARD_ORIGIN=http://localhost:5173
RUNS_DIR=../runs
